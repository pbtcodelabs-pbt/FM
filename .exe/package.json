{
  "name": "saddam-fruit-mandi",
  "productName": "Saddam Fruit Mandi",
  "version": "1.0.0",
  "description": "صدام فروٹ منڈی — کمپیوٹر ایڈیشن",
  "author": "PBT Code Labs",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pbtcodelabs.saddamfruitmandi.desktop",
    "productName": "Saddam Fruit Mandi",
    "copyright": "PBT Code Labs",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "offline.html", "build/icon.png"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "SaddamFruitMandi-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "صدام فروٹ منڈی",
      "uninstallDisplayName": "صدام فروٹ منڈی",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
